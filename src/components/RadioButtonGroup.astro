---
//div: etiqueta abierta
//     tienen elementos dentro
//     permite especificar propiedades de ubicacion
   interface Props {
        etiqueta: string
    }


    //Crear una variable
    //para recibir la etiqueta
    const  etiqueta  = Astro.props.etiqueta;
---
<div class="rbg">
    <label>{etiqueta}</label>
    <div id="Cedula">
        <input class="radio-bot"
        type="radio"
        name="rbg"
        id="radio1"
    /> C.C
    </div>
    <div id="TarjetaIdentidad">
    <input class="radio-boto"
        type="radio"
        name="rbg"
        id="radio2"
    /> T.I
    </div>
    <div id="CedulaExtran">
    <input class="rad-boton"
        type="radio"
        name="rbg"
        id="radio3"
    /> C.E
    </div>

</div>
<style>
    .rbg{
        background-color: rgb(220, 247, 247);
        border-color:rgb(115, 44, 182);
        border-width: 3px;
        border-style: solid;
        border-radius: 15px;
        margin: 10px 0 10px 20px;
        /*margin: 40px 0 10px*/
        width: 90%;
    }
    
    #Cedula .radio-bot{
        background-color: burlywood;
        display: inline-block;
        /*display:
          determina como una etiqueta
          se comportara en cuanto a:display:
          -largo
          -ancho
          -ubicación*/
        width:20px;
        height:12px;
    }
    #TarjetaIdentidad .radio-boto{
        background-color: darkcyan;
        display: inline-block;
        width:20px;
        height:12px;
    }
    #CedulaExtran .rad-boton{
        background-color: cornflowerblue;
        display: inline-block;
        width:20px;
        height:12px;
    }
</style>